<Prefab>
    <Window>
        <Widget DataSource="{ModInventory}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                SuggestedWidth="560" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="115">
            <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="VerticalTopToBottom">
                    <Children>

                        <!-- AI request row: free text in, structured equip plan out -->
                        <ListPanel DataSource="{Ai}" IsVisible="@IsConfigured" WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight">
                            <Children>
                                <BrushWidget UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                             SuggestedWidth="330" SuggestedHeight="50" VerticalAlignment="Center"
                                             Brush="SaveLoad.Search.Button">
                                    <Children>
                                        <EditableTextWidget UpdateChildrenStates="true" WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="StretchToParent" MarginTop="10"
                                                            MarginBottom="10" MarginLeft="10" MarginRight="10"
                                                            Brush="SaveLoad.Search.InputText" Text="@PromptText"/>
                                    </Children>
                                </BrushWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                              HeightSizePolicy="Fixed" SuggestedWidth="105" SuggestedHeight="50"
                                              MarginLeft="5" VerticalAlignment="Center" Brush="ButtonBrush2"
                                              Command.Click="ExecuteInterpret" IsDisabled="@IsBusy"
                                              UpdateChildrenStates="true">
                                    <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Brush="Popup.Button.Text" Text="@InterpretButtonText"/>
                                    </Children>
                                </ButtonWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                              HeightSizePolicy="Fixed" SuggestedWidth="105" SuggestedHeight="50"
                                              MarginLeft="5" VerticalAlignment="Center" Brush="ButtonBrush1"
                                              Command.Click="ExecuteApply" IsEnabled="@CanApply"
                                              UpdateChildrenStates="true">
                                    <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Brush="Popup.Button.Text" Text="@ApplyButtonText"/>
                                    </Children>
                                </ButtonWidget>
                            </Children>
                        </ListPanel>

                        <!-- Action buttons: equip current, equip all, panel search toggles -->
                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="4"
                                   HorizontalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight">
                            <Children>

                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                              HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40"
                                              VerticalAlignment="Center"
                                              Brush="EquipBestItem.EquipCurrentCharacterButton"
                                              Command.Click="ExecuteEquipAllBest">
                                    <Children>
                                        <HintWidget DoNotAcceptEvents="true" DataSource="{EquipCurrentHint}"
                                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Command.HoverBegin="ExecuteBeginHint"
                                                    Command.HoverEnd="ExecuteEndHint"/>
                                    </Children>
                                </ButtonWidget>

                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                              HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40"
                                              MarginLeft="8" VerticalAlignment="Center"
                                              Brush="EquipBestItem.EquipAllCharactersButton"
                                              Command.Click="ExecuteEquipAllCharacters">
                                    <Children>
                                        <HintWidget DoNotAcceptEvents="true" DataSource="{EquipAllHint}"
                                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Command.HoverBegin="ExecuteBeginHint"
                                                    Command.HoverEnd="ExecuteEndHint"/>
                                    </Children>
                                </ButtonWidget>

                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                              HeightSizePolicy="Fixed" SuggestedWidth="36" SuggestedHeight="36"
                                              MarginLeft="24" VerticalAlignment="Center"
                                              Command.Click="ExecuteToggleLeftPanelSearch">
                                    <Children>
                                        <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                     HeightSizePolicy="StretchToParent" IsVisible="@IsLeftPanelSearched"
                                                     Brush="EquipBestItem.LockPanelButton.Opened"/>
                                        <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                     HeightSizePolicy="StretchToParent" IsVisible="@IsLeftPanelLocked"
                                                     Brush="EquipBestItem.LockPanelButton.Closed"/>
                                        <HintWidget DoNotAcceptEvents="true" DataSource="{LeftPanelLockHint}"
                                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Command.HoverBegin="ExecuteBeginHint"
                                                    Command.HoverEnd="ExecuteEndHint"/>
                                    </Children>
                                </ButtonWidget>

                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                              HeightSizePolicy="Fixed" SuggestedWidth="36" SuggestedHeight="36"
                                              MarginLeft="8" VerticalAlignment="Center"
                                              Command.Click="ExecuteToggleRightPanelSearch">
                                    <Children>
                                        <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                     HeightSizePolicy="StretchToParent" IsVisible="@IsRightPanelSearched"
                                                     Brush="EquipBestItem.LockPanelButton.Opened"/>
                                        <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                     HeightSizePolicy="StretchToParent" IsVisible="@IsRightPanelLocked"
                                                     Brush="EquipBestItem.LockPanelButton.Closed"/>
                                        <HintWidget DoNotAcceptEvents="true" DataSource="{RightPanelLockHint}"
                                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Command.HoverBegin="ExecuteBeginHint"
                                                    Command.HoverEnd="ExecuteEndHint"/>
                                    </Children>
                                </ButtonWidget>

                            </Children>
                        </ListPanel>

                        <!-- AI status line -->
                        <TextWidget DataSource="{Ai}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    MarginTop="2" Brush="Popup.Button.Text" Text="@StatusText"/>

                    </Children>
                </ListPanel>
            </Children>
        </Widget>
    </Window>
</Prefab>
