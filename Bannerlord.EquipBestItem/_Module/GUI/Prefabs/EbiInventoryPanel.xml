<Prefab>
    <!-- Same slide-in the native side panels use (Inventory.xml LeftMenu/
         RightMenu): the wrapper starts 578 units off to the side - the game's
         SidePanel.Width (554px tuple_right sprite + 24) - and eases to its
         resting spot when the screen opens. -->
    <VisualDefinitions>
        <VisualDefinition Name="EbiLeftSlide" EaseType="EaseOut" EaseFunction="Quint" TransitionDuration="0.45">
            <VisualState PositionXOffset="0" State="Default"/>
        </VisualDefinition>
        <VisualDefinition Name="EbiRightSlide" EaseType="EaseOut" EaseFunction="Quint" TransitionDuration="0.45">
            <VisualState PositionXOffset="0" State="Default"/>
        </VisualDefinition>
    </VisualDefinitions>
    <Window>
        <Widget DataSource="{ModInventory}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                DoNotAcceptEvents="true">
            <Children>

                <!-- Two plaques at the top of the center panel, flanking the
                     character name (legacy placement). Built exactly like the
                     game's InventoryEquippedItemControls: a fixed-size
                     background (the brush sprite's own 146x69, so nothing
                     stretches) holding 35x35 toolbox_icon_bed sockets with a
                     button inset by 3px in each. -->

                <!-- Left plaque: lock for the left (merchant/loot) panel + equip all heroes.
                     The background is drawn for three sockets but holds two, so it is
                     pushed one socket-width past the edge and the sockets are laid out
                     evenly on the visible part. -->
                <Widget VisualDefinition="EbiLeftSlide" WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent" PositionXOffset="-578"
                        DoNotAcceptEvents="true">
                    <Children>
                <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="146"
                             SuggestedHeight="69" HorizontalAlignment="Left" MarginTop="82"
                             PositionXOffset="-43"
                             Brush="Inventory.EquipedItemControls.Background.HorizontalFlip">
                    <Children>
                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Right" MarginRight="18" VerticalAlignment="Center"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                            <Children>

                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="35"
                                        SuggestedHeight="35" VerticalAlignment="Center"
                                        Sprite="Inventory\toolbox_icon_bed">
                                    <Children>
                                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                      MarginLeft="6" MarginRight="6" MarginTop="6" MarginBottom="6"
                                                      UpdateChildrenStates="true"
                                                      Command.Click="ExecuteToggleLeftPanelSearch">
                                            <Children>
                                                <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                             HeightSizePolicy="StretchToParent"
                                                             IsVisible="@IsLeftPanelSearched"
                                                             Brush="EquipBestItem.LockPanelButton.Opened"/>
                                                <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                             HeightSizePolicy="StretchToParent"
                                                             IsVisible="@IsLeftPanelLocked"
                                                             Brush="EquipBestItem.LockPanelButton.Closed"/>
                                                <HintWidget DoNotAcceptEvents="true" DataSource="{LeftPanelLockHint}"
                                                            WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="StretchToParent"
                                                            Command.HoverBegin="ExecuteBeginHint"
                                                            Command.HoverEnd="ExecuteEndHint"/>
                                            </Children>
                                        </ButtonWidget>
                                    </Children>
                                </Widget>

                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="35"
                                        SuggestedHeight="35" MarginLeft="2" VerticalAlignment="Center"
                                        Sprite="Inventory\toolbox_icon_bed">
                                    <Children>
                                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                      MarginLeft="3" MarginRight="3" MarginTop="3" MarginBottom="3"
                                                      Brush="EquipBestItem.EquipAllCharactersButton"
                                                      Command.Click="ExecuteEquipAllCharacters">
                                            <Children>
                                                <HintWidget DoNotAcceptEvents="true" DataSource="{EquipAllHint}"
                                                            WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="StretchToParent"
                                                            Command.HoverBegin="ExecuteBeginHint"
                                                            Command.HoverEnd="ExecuteEndHint"/>
                                            </Children>
                                        </ButtonWidget>
                                    </Children>
                                </Widget>

                            </Children>
                        </ListPanel>
                    </Children>
                </BrushWidget>
                    </Children>
                </Widget>

                <!-- Right plaque: equip current character + lock for the right panel
                     + ask AI in the rightmost socket. Without an AI backend the
                     plaque slides right by one socket (@RightPlaqueOffset),
                     hiding the unused space just like the left plaque. -->
                <Widget VisualDefinition="EbiRightSlide" WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent" PositionXOffset="578"
                        DoNotAcceptEvents="true">
                    <Children>
                <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="146"
                             SuggestedHeight="69" HorizontalAlignment="Right" MarginTop="82"
                             PositionXOffset="@RightPlaqueOffset"
                             Brush="Inventory.EquipedItemControls.Background">
                    <Children>
                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" MarginLeft="18" VerticalAlignment="Center"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                            <Children>

                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="35"
                                        SuggestedHeight="35" VerticalAlignment="Center"
                                        Sprite="Inventory\toolbox_icon_bed">
                                    <Children>
                                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                      MarginLeft="3" MarginRight="3" MarginTop="3" MarginBottom="3"
                                                      Brush="EquipBestItem.EquipCurrentCharacterButton"
                                                      Command.Click="ExecuteEquipAllBest">
                                            <Children>
                                                <HintWidget DoNotAcceptEvents="true" DataSource="{EquipCurrentHint}"
                                                            WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="StretchToParent"
                                                            Command.HoverBegin="ExecuteBeginHint"
                                                            Command.HoverEnd="ExecuteEndHint"/>
                                            </Children>
                                        </ButtonWidget>
                                    </Children>
                                </Widget>

                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="35"
                                        SuggestedHeight="35" MarginLeft="2" VerticalAlignment="Center"
                                        Sprite="Inventory\toolbox_icon_bed">
                                    <Children>
                                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                      MarginLeft="6" MarginRight="6" MarginTop="6" MarginBottom="6"
                                                      UpdateChildrenStates="true"
                                                      Command.Click="ExecuteToggleRightPanelSearch">
                                            <Children>
                                                <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                             HeightSizePolicy="StretchToParent"
                                                             IsVisible="@IsRightPanelSearched"
                                                             Brush="EquipBestItem.LockPanelButton.Opened"/>
                                                <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                             HeightSizePolicy="StretchToParent"
                                                             IsVisible="@IsRightPanelLocked"
                                                             Brush="EquipBestItem.LockPanelButton.Closed"/>
                                                <HintWidget DoNotAcceptEvents="true" DataSource="{RightPanelLockHint}"
                                                            WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="StretchToParent"
                                                            Command.HoverBegin="ExecuteBeginHint"
                                                            Command.HoverEnd="ExecuteEndHint"/>
                                            </Children>
                                        </ButtonWidget>
                                    </Children>
                                </Widget>

                                <!-- Ask AI: opens the game's native text inquiry; the plan
                                     lands in the slot filters. Hidden when no backend. -->
                                <Widget DataSource="{Ai}" IsVisible="@IsConfigured" WidthSizePolicy="CoverChildren"
                                        HeightSizePolicy="CoverChildren" VerticalAlignment="Center">
                                    <Children>
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="35"
                                                SuggestedHeight="35" MarginLeft="2"
                                                Sprite="Inventory\toolbox_icon_bed">
                                            <Children>
                                                <ButtonWidget WidthSizePolicy="StretchToParent"
                                                              HeightSizePolicy="StretchToParent"
                                                              MarginLeft="3" MarginRight="3" MarginTop="3"
                                                              MarginBottom="3" Brush="EquipBestItem.AiButton"
                                                              Command.Click="ExecuteOpenPrompt"
                                                              IsDisabled="@IsBusy" UpdateChildrenStates="true">
                                                    <Children>
                                                        <TextWidget DoNotAcceptEvents="true"
                                                                    WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Brush="EquipBestItem.AiButton.Text" Text="AI"/>
                                                        <HintWidget DoNotAcceptEvents="true" DataSource="{AskHint}"
                                                                    WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Command.HoverBegin="ExecuteBeginHint"
                                                                    Command.HoverEnd="ExecuteEndHint"/>
                                                    </Children>
                                                </ButtonWidget>
                                            </Children>
                                        </Widget>
                                    </Children>
                                </Widget>

                            </Children>
                        </ListPanel>
                    </Children>
                </BrushWidget>
                    </Children>
                </Widget>

                <!-- The AI assistant's replies go to the game message log (chat), not a panel line. -->

            </Children>
        </Widget>
    </Window>
</Prefab>
