<Prefab>
    <Window>
        <Widget DataSource="{ModInventory}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                DoNotAcceptEvents="true">
            <Children>
                <Widget DataSource="{SlotSettings}" IsVisible="@IsVisible" WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent">
                    <Children>

                        <!-- Dim and swallow clicks outside the dialog. Plain Widget:
                             BrushWidget ignores the Color attribute and renders the sprite white. -->
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.55"/>

                        <!-- The wrapper is 30px wider than the frame on every side so the
                             close cross, which sticks out of the frame corner, still lies
                             inside its ancestors' bounds — Gauntlet hit-testing never
                             reaches a child outside its parent's rect. -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="600"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Children>
                        <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="540"
                                     HorizontalAlignment="Center" MarginTop="30" MarginBottom="30" Brush="Frame1Brush">
                            <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                           MarginTop="20" MarginBottom="20" MarginLeft="25" MarginRight="25"
                                           StackLayout.LayoutMethod="VerticalTopToBottom">
                                    <Children>

                                        <!-- Header with the "default values" marker on its right,
                                             shown while the hero follows the defaults for this slot -->
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                                SuggestedHeight="45">
                                            <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="StretchToParent"
                                                            Brush="Popup.Button.Text" Text="@HeaderText"/>
                                                <TextWidget IsVisible="@IsOnDefault" WidthSizePolicy="CoverChildren"
                                                            HeightSizePolicy="StretchToParent"
                                                            HorizontalAlignment="Right"
                                                            Brush="EquipBestItem.Label.Left"
                                                            Text="@OnDefaultText"/>
                                            </Children>
                                        </Widget>

                                        <!-- Culture restriction selector; "any culture" disables it -->
                                        <ListPanel WidthSizePolicy="CoverChildren" HorizontalAlignment="Center" HeightSizePolicy="Fixed"
                                                   SuggestedHeight="50" MarginTop="5"
                                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                                            <Children>
                                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                                              HeightSizePolicy="Fixed" SuggestedWidth="60"
                                                              SuggestedHeight="43" VerticalAlignment="Center"
                                                              Brush="SPOptions.Dropdown.Left.Button"
                                                              Command.Click="ExecutePreviousCulture"/>
                                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                                            SuggestedWidth="330" Brush="Popup.Button.Text"
                                                            Text="@CultureText"/>
                                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                                              HeightSizePolicy="Fixed" SuggestedWidth="60"
                                                              SuggestedHeight="43" VerticalAlignment="Center"
                                                              Brush="SPOptions.Dropdown.Right.Button"
                                                              Command.Click="ExecuteNextCulture"/>
                                            </Children>
                                        </ListPanel>

                                        <!-- Max item weight cap; 0 = off -->
                                        <ListPanel WidthSizePolicy="CoverChildren" HorizontalAlignment="Center" HeightSizePolicy="Fixed"
                                                   SuggestedHeight="56"
                                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                                            <Children>
                                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                                            SuggestedWidth="185" Brush="EquipBestItem.Label.Right"
                                                            Text="@MaxWeightLabel"/>
                                                <SliderWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                              SuggestedWidth="138" SuggestedHeight="42"
                                                              VerticalAlignment="Center" MarginLeft="20"
                                                              DoNotUpdateHandleSize="true" Filler="Filler"
                                                              Handle="SliderHandle" IsDiscrete="false"
                                                              MinValueFloat="0" MaxValueFloat="40"
                                                              ValueFloat="@MaxItemWeight">
                                                    <Children>
                                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                                SuggestedWidth="138" SuggestedHeight="38"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" IsEnabled="false"
                                                                Sprite="SPGeneral\SPOptions\standart_slider_canvas"/>
                                                        <Widget Id="Filler" WidthSizePolicy="Fixed"
                                                                HeightSizePolicy="Fixed" SuggestedWidth="345"
                                                                SuggestedHeight="35" VerticalAlignment="Center"
                                                                Sprite="SPGeneral\SPOptions\standart_slider_fill"
                                                                ClipContents="true">
                                                            <Children>
                                                                <Widget WidthSizePolicy="Fixed"
                                                                        HeightSizePolicy="Fixed"
                                                                        SuggestedWidth="345"
                                                                        SuggestedHeight="35"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Sprite="SPGeneral\SPOptions\standart_slider_fill"/>
                                                            </Children>
                                                        </Widget>
                                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                                SuggestedWidth="160" SuggestedHeight="65"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" IsEnabled="false"
                                                                Sprite="SPGeneral\SPOptions\standart_slider_frame"/>
                                                        <ImageWidget Id="SliderHandle" DoNotAcceptEvents="true"
                                                                     WidthSizePolicy="Fixed"
                                                                     HeightSizePolicy="Fixed"
                                                                     SuggestedWidth="14" SuggestedHeight="38"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Center"
                                                                     Brush="SPOptions.Slider.Handle"/>
                                                    </Children>
                                                </SliderWidget>
                                                <TextWidget WidthSizePolicy="Fixed"
                                                            HeightSizePolicy="StretchToParent"
                                                            SuggestedWidth="75" MarginLeft="20"
                                                            Brush="EquipBestItem.Label.Left" Text="@MaxItemWeightText"/>
                                            </Children>
                                        </ListPanel>

                                        <!-- Weapon class pin (weapon slots only) -->
                                        <ListPanel IsVisible="@IsWeaponSlot" WidthSizePolicy="CoverChildren" HorizontalAlignment="Center"
                                                   HeightSizePolicy="Fixed" SuggestedHeight="50" MarginTop="5"
                                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                                            <Children>
                                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                                              HeightSizePolicy="Fixed" SuggestedWidth="60"
                                                              SuggestedHeight="43" VerticalAlignment="Center"
                                                              Brush="SPOptions.Dropdown.Left.Button"
                                                              Command.Click="ExecutePreviousWeaponClass"/>
                                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                                            SuggestedWidth="330" Brush="Popup.Button.Text"
                                                            Text="@WeaponClassText"/>
                                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                                              HeightSizePolicy="Fixed" SuggestedWidth="60"
                                                              SuggestedHeight="43" VerticalAlignment="Center"
                                                              Brush="SPOptions.Dropdown.Right.Button"
                                                              Command.Click="ExecuteNextWeaponClass"/>
                                            </Children>
                                        </ListPanel>

                                        <!-- One template row per visible parameter -->
                                        <ListPanel DataSource="{Rows}" WidthSizePolicy="StretchToParent"
                                                   HeightSizePolicy="CoverChildren" MarginTop="10"
                                                   StackLayout.LayoutMethod="VerticalTopToBottom">
                                            <ItemTemplate>
                                                <ListPanel WidthSizePolicy="CoverChildren" HorizontalAlignment="Center" HeightSizePolicy="Fixed" SuggestedHeight="56" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                                    <Children>
                                                        <TextWidget WidthSizePolicy="Fixed"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    SuggestedWidth="185" Brush="EquipBestItem.Label.Right"
                                                                    Text="@Name"/>
                                                        <!-- Structure copied from the proven legacy slider markup -->
                                                        <SliderWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                                      SuggestedWidth="138" SuggestedHeight="42"
                                                                      VerticalAlignment="Center" MarginLeft="20"
                                                                      DoNotUpdateHandleSize="true" Filler="Filler"
                                                                      Handle="SliderHandle" IsDiscrete="false"
                                                                      MinValueFloat="-1.0" MaxValueFloat="1.0"
                                                                      ValueFloat="@Value">
                                                            <Children>
                                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                                        SuggestedWidth="138" SuggestedHeight="38"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" IsEnabled="false"
                                                                        Sprite="SPGeneral\SPOptions\standart_slider_canvas"/>
                                                                <Widget Id="Filler" WidthSizePolicy="Fixed"
                                                                        HeightSizePolicy="Fixed" SuggestedWidth="345"
                                                                        SuggestedHeight="35" VerticalAlignment="Center"
                                                                        Sprite="SPGeneral\SPOptions\standart_slider_fill"
                                                                        ClipContents="true">
                                                                    <Children>
                                                                        <Widget WidthSizePolicy="Fixed"
                                                                                HeightSizePolicy="Fixed"
                                                                                SuggestedWidth="345"
                                                                                SuggestedHeight="35"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Sprite="SPGeneral\SPOptions\standart_slider_fill"/>
                                                                    </Children>
                                                                </Widget>
                                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                                        SuggestedWidth="160" SuggestedHeight="65"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" IsEnabled="false"
                                                                        Sprite="SPGeneral\SPOptions\standart_slider_frame"/>
                                                                <ImageWidget Id="SliderHandle" DoNotAcceptEvents="true"
                                                                             WidthSizePolicy="Fixed"
                                                                             HeightSizePolicy="Fixed"
                                                                             SuggestedWidth="14" SuggestedHeight="38"
                                                                             HorizontalAlignment="Left"
                                                                             VerticalAlignment="Center"
                                                                             Brush="SPOptions.Slider.Handle"/>
                                                            </Children>
                                                        </SliderWidget>
                                                        <TextWidget WidthSizePolicy="Fixed"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    SuggestedWidth="75" MarginLeft="20"
                                                                    Brush="EquipBestItem.Label.Left" Text="@ValueText"/>
                                                    </Children>
                                                </ListPanel>
                                            </ItemTemplate>
                                        </ListPanel>

                                        <!-- Actions: Default restores the (player-editable) defaults,
                                             Make default saves the current filter as that default,
                                             Lock zeroes the weights which excludes the slot -->
                                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                                   MarginTop="15" HorizontalAlignment="Center"
                                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                                            <Children>
                                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                                              HeightSizePolicy="Fixed" SuggestedWidth="130"
                                                              SuggestedHeight="55" Brush="Popup.Button.Base"
                                                              Command.Click="ExecuteReset" UpdateChildrenStates="true">
                                                    <Children>
                                                        <HintWidget DoNotAcceptEvents="true"
                                                                    DataSource="{DefaultButtonHint}"
                                                                    WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Command.HoverBegin="ExecuteBeginHint"
                                                                    Command.HoverEnd="ExecuteEndHint"/>
                                                        <TextWidget WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Brush="Popup.Button.Text"
                                                                    Text="@DefaultButtonText"/>
                                                    </Children>
                                                </ButtonWidget>
                                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                                              HeightSizePolicy="Fixed" SuggestedWidth="210"
                                                              SuggestedHeight="55" MarginLeft="10"
                                                              Brush="Popup.Button.Base"
                                                              Command.Click="ExecuteMakeDefault"
                                                              UpdateChildrenStates="true">
                                                    <Children>
                                                        <HintWidget DoNotAcceptEvents="true"
                                                                    DataSource="{MakeDefaultButtonHint}"
                                                                    WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Command.HoverBegin="ExecuteBeginHint"
                                                                    Command.HoverEnd="ExecuteEndHint"/>
                                                        <TextWidget WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Brush="Popup.Button.Text"
                                                                    Text="@MakeDefaultButtonText"/>
                                                    </Children>
                                                </ButtonWidget>
                                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed"
                                                              HeightSizePolicy="Fixed" SuggestedWidth="130"
                                                              SuggestedHeight="55" MarginLeft="10"
                                                              Brush="Popup.Button.Base" Command.Click="ExecuteLock"
                                                              UpdateChildrenStates="true">
                                                    <Children>
                                                        <HintWidget DoNotAcceptEvents="true"
                                                                    DataSource="{LockButtonHint}"
                                                                    WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Command.HoverBegin="ExecuteBeginHint"
                                                                    Command.HoverEnd="ExecuteEndHint"/>
                                                        <TextWidget WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Brush="Popup.Button.Text"
                                                                    Text="@LockButtonText"/>
                                                    </Children>
                                                </ButtonWidget>
                                            </Children>
                                        </ListPanel>

                                    </Children>
                                </ListPanel>
                            </Children>
                        </BrushWidget>

                        <!-- Close cross: anchored to the wrapper corner, which puts it
                             half outside the frame yet fully hit-testable. -->
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70"
                                      SuggestedHeight="70" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Command.Click="ExecuteClose" Brush="Popup.CloseButton"/>
                            </Children>
                        </Widget>
                    </Children>
                </Widget>
            </Children>
        </Widget>
    </Window>
</Prefab>
