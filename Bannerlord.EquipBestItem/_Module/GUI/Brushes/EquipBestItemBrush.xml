<Brushes>
    <Brush Name="EquipBestItem.SlotButton">
        <Layers>
            <BrushLayer Name="Default" Sprite="equipbestitem_button_equip"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" ColorFactor="0.4"
                            IsHidden="false"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" ColorFactor="1.5"
                            IsHidden="false"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" ColorFactor="2"
                            IsHidden="false"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" ColorFactor="0.1" IsHidden="true"/>
            </Style>
        </Styles>
        <SoundProperties>
            <EventSounds>
                <EventSound EventName="Click" Audio="popup"/>
            </EventSounds>
        </SoundProperties>
    </Brush>
    <Brush Name="EquipBestItem.SlotButton.Flipped">
        <Layers>
            <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" HorizontalFlip="true"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" HorizontalFlip="true"
                            ColorFactor="0.4" IsHidden="false"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" HorizontalFlip="true"
                            ColorFactor="1.5" IsHidden="false"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" HorizontalFlip="true"
                            ColorFactor="2" IsHidden="false"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" Sprite="equipbestitem_button_equip" HorizontalFlip="true"
                            ColorFactor="0.1" IsHidden="true"/>
            </Style>
        </Styles>
        <SoundProperties>
            <EventSounds>
                <EventSound EventName="Click" Audio="popup"/>
            </EventSounds>
        </SoundProperties>
    </Brush>
    <Brush Name="Inventory.EquipedItemControls.Background.HorizontalFlip">
        <Layers>
            <BrushLayer Name="Default" Sprite="Inventory\toolbox" HorizontalFlip="true"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default"/>
            </Style>
        </Styles>
    </Brush>
    <Brush Name="InventoryEquipButton">
        <Layers>
            <BrushLayer Name="Default" Sprite="Inventory\icon_equip"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" ColorFactor="1.0"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" ColorFactor="1.5"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" ColorFactor="0.85"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" ColorFactor="0.2"/>
            </Style>
            <Style Name="Selected">
                <BrushLayer Name="Default" ColorFactor="2.0"/>
            </Style>
        </Styles>
    </Brush>
    <Brush Name="EquipBestItem.EquipAllCharactersButton">
        <Layers>
            <BrushLayer Name="Default" Sprite="equipbestitem_button_equip_all"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" ColorFactor="1.0"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" ColorFactor="1.5"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" ColorFactor="0.85"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" ColorFactor="0.2"/>
            </Style>
        </Styles>
    </Brush>
    <Brush Name="EquipBestItem.EquipCurrentCharacterButton">
        <Layers>
            <BrushLayer Name="Default" Sprite="Inventory\equip"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" ColorFactor="1.0"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" ColorFactor="1.5"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" ColorFactor="0.85"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" ColorFactor="0.2"/>
            </Style>
        </Styles>
    </Brush>
    <!-- Invisible in every state: exists only for the click sound; the
         hover feedback lives on the text (EquipBestItem.AiButton.Text). -->
    <Brush Name="EquipBestItem.AiButton">
        <Layers>
            <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" AlphaFactor="0"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" AlphaFactor="0"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" AlphaFactor="0"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" AlphaFactor="0"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" AlphaFactor="0"/>
            </Style>
        </Styles>
        <SoundProperties>
            <EventSounds>
                <EventSound EventName="Click" Audio="popup"/>
            </EventSounds>
        </SoundProperties>
    </Brush>
    <!-- Popup.Button.Text lookalikes with left/right alignment for the popup
         rows: labels end at a fixed gap before the slider, values start at a
         fixed gap after it. -->
    <Brush Name="EquipBestItem.Label.Right" Font="Galahad" TextHorizontalAlignment="Right"
           TextVerticalAlignment="Center">
        <Styles>
            <Style Name="Default" FontColor="#F8E3BEFF" FontSize="24"/>
        </Styles>
    </Brush>
    <Brush Name="EquipBestItem.Label.Left" Font="Galahad" TextHorizontalAlignment="Left"
           TextVerticalAlignment="Center">
        <Styles>
            <Style Name="Default" FontColor="#F8E3BEFF" FontSize="24"/>
        </Styles>
    </Brush>
    <!-- Popup.Button.Text (Galahad 24, #F8E3BE) plus hover/pressed brightening. -->
    <Brush Name="EquipBestItem.AiButton.Text" Font="Galahad" TextHorizontalAlignment="Center"
           TextVerticalAlignment="Center">
        <Styles>
            <Style Name="Default" FontColor="#F8E3BEFF" FontSize="24"/>
            <Style Name="Hovered" FontColor="#FFFFFFFF" FontSize="24"/>
            <Style Name="Pressed" FontColor="#FFFFFFFF" FontSize="24"/>
            <Style Name="Disabled" FontColor="#F8E3BEFF" TextAlphaFactor="0.5" FontSize="24"/>
        </Styles>
    </Brush>
    <Brush Name="EquipBestItem.LockPanelButton.Opened">
        <Layers>
            <BrushLayer Name="Default" Sprite="StdAssets\lock_opened"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" ColorFactor="1"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" ColorFactor="1.4"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" ColorFactor="1.4"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" ColorFactor="0.1"/>
            </Style>
        </Styles>
        <SoundProperties>
            <StateSounds>
            </StateSounds>
            <EventSounds>
                <EventSound EventName="Click" Audio="popup"/>
            </EventSounds>
        </SoundProperties>
    </Brush>
    <Brush Name="EquipBestItem.LockPanelButton.Closed">
        <Layers>
            <BrushLayer Name="Default" Sprite="StdAssets\lock_closed"/>
        </Layers>
        <Styles>
            <Style Name="Default">
                <BrushLayer Name="Default" ColorFactor="1"/>
            </Style>
            <Style Name="Hovered">
                <BrushLayer Name="Default" ColorFactor="1.4"/>
            </Style>
            <Style Name="Pressed">
                <BrushLayer Name="Default" ColorFactor="1.4"/>
            </Style>
            <Style Name="Disabled">
                <BrushLayer Name="Default" ColorFactor="0.1"/>
            </Style>
        </Styles>
        <SoundProperties>
            <StateSounds>
            </StateSounds>
            <EventSounds>
                <EventSound EventName="Click" Audio="popup"/>
            </EventSounds>
        </SoundProperties>
    </Brush>
</Brushes>