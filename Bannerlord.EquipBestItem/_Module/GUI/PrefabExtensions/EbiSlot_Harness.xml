<!-- Equip-best button for the Harness slot (legacy geometry: 14x14, top-left).
     The transparent wrapper stretches over the whole slot so the game anchors
     the native comparison tooltip beside the slot (it positions the tooltip
     relative to the hovered widget's PARENT), not on top of the button.
     IsRightSide matches the native slot so the tooltip opens away from it. -->
<Children>
    <Widget DataSource="{ModInventory}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent">
        <Children>
            <Widget DataSource="{SlotHarness}" IsVisible="@HasTooltipItem" DoNotAcceptEvents="true"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                <Children>
                    <EbiFoundItemTooltipWidget DataSource="{BestItem}" IsRightSide="false" DoNotAcceptEvents="true"
                                               WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="14"
                                               SuggestedHeight="14" MarginTop="5" MarginLeft="5"
                                               HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Children>
                            <EbiEquipButtonWidget DataSource="{..}" IsDisabled="@IsButtonDisabled"
                                                  Command.Click="ExecuteEquip"
                                                  Command.AlternateClick="ExecuteOpenSettings"
                                                  WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                  Brush="EquipBestItem.SlotButton"/>
                        </Children>
                    </EbiFoundItemTooltipWidget>
                </Children>
            </Widget>
        </Children>
    </Widget>
</Children>
