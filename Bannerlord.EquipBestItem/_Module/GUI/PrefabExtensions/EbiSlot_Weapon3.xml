<!-- Equip-best button for the Weapon3 slot (14x14, top-right, mirrored).
     Two stacked variants of the same button:
     - with the tooltip wrapper, shown when there is an item to preview; the
       transparent slot-sized wrapper makes the game anchor the native
       comparison tooltip beside the slot (it positions the tooltip relative
       to the hovered widget's PARENT), IsRightSide matching the native slot;
     - without the wrapper, shown otherwise: normally hidden, revealed with
       Alt so the search settings stay reachable (e.g. to pin a weapon class
       on an empty slot), and hover cannot leave a stale tooltip because no
       tooltip widget is above it. -->
<Children>
    <Widget DataSource="{ModInventory}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent">
        <Children>
            <Widget DataSource="{SlotWeapon3}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                    HeightSizePolicy="StretchToParent">
                <Children>

                    <Widget IsVisible="@HasTooltipItem" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent">
                        <Children>
                            <EbiFoundItemTooltipWidget DataSource="{BestItem}" IsRightSide="true"
                                                       DoNotAcceptEvents="true" WidthSizePolicy="Fixed"
                                                       HeightSizePolicy="Fixed" SuggestedWidth="14"
                                                       SuggestedHeight="14" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="5" MarginRight="5">
                                <Children>
                                    <EbiEquipButtonWidget DataSource="{..}" IsDisabled="@IsButtonDisabled"
                                                          Command.Click="ExecuteEquip"
                                                          Command.AlternateClick="ExecuteOpenSettings"
                                                          WidthSizePolicy="StretchToParent"
                                                          HeightSizePolicy="StretchToParent"
                                                          Brush="EquipBestItem.SlotButton.Flipped"/>
                                </Children>
                            </EbiFoundItemTooltipWidget>
                        </Children>
                    </Widget>

                    <Widget IsVisible="@HasNoTooltipItem" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent">
                        <Children>
                            <EbiEquipButtonWidget IsDisabled="@IsButtonDisabled" Command.Click="ExecuteEquip"
                                                  Command.AlternateClick="ExecuteOpenSettings"
                                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                  SuggestedWidth="14" SuggestedHeight="14" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="5" MarginRight="5"
                                                  Brush="EquipBestItem.SlotButton.Flipped"/>
                        </Children>
                    </Widget>

                </Children>
            </Widget>
        </Children>
    </Widget>
</Children>
