<!-- Inserted into InventoryEquippedItemSlot. The native prefab is instantiated
     once per equipment slot with a unique *DropTag ("Equipment_0".."Equipment_11"),
     which the buttons pass back so the view model knows which slot was clicked. -->
<ListPanel Id="EbiSlotButtons" DataSource="{ModInventory}" WidthSizePolicy="CoverChildren"
           HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Top"
           PositionYOffset="-4" StackLayout.LayoutMethod="HorizontalLeftToRight">
    <Children>
        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="26" SuggestedHeight="26" Brush="EquipBestItem.SlotButton"
                      Command.Click="ExecuteEquipBest" CommandParameter.Click="*DropTag"/>
        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="26" SuggestedHeight="26" MarginLeft="4" Brush="InventoryInspectButton"
                      Command.Click="ExecuteOpenSlotSettings" CommandParameter.Click="*DropTag"/>
    </Children>
</ListPanel>
