        <string id="EbiMcmButtonColor" text="슬롯 버튼 색상"/>
        <string id="EbiMcmButtonColorHint" text="슬롯별 장착 버튼의 색조, #RRGGBB 또는 #RRGGBBAA. #FFFFFF는 원래 모습을 유지합니다. 인벤토리를 다시 열면 적용됩니다."/>
        <string id="EbiMcmButtonColorReset" text="버튼 색상 초기화"/>
